[Unit]
Description=AmneziaWG peer policy and usage manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/awg-manager/manager.env
ExecStart=/usr/local/sbin/awg-manager daemon
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/awg-manager
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
